# Development configuration. Copy to .env (git-ignored) and adjust:  cp .env.example .env
# docker compose reads .env automatically. Production template: .env.prod.example (docs/deployment.md).
APP_ENV=dev

# Warehouse credentials (no defaults in docker-compose.yml or the code: they must come from here).
# Only applied when the Postgres volume is first created; see docs/deployment.md to change them later.
PG_USER=de
PG_PASSWORD=de
PG_DB=shop

# Host ports
PG_HOST_PORT=5433
PREFECT_PORT=4200
DASHBOARD_PORT=8501

# Schedules (cron, in SCHEDULE_TZ)
SCHEDULE_TZ=Asia/Kolkata
DAILY_CRON=0 2 * * *
MAINTENANCE_CRON=0 3 * * 0

# Alerts: Slack-compatible incoming webhook for failed/crashed/cancelled runs (empty = log only)
ALERT_WEBHOOK_URL=

# Logging: text (readable) or json (one JSON object per line, for log tools)
LOG_FORMAT=text

# Pipeline behaviour
WATERMARK_LOOKBACK_MINUTES=10
SCHEMA_DRIFT_ALLOW_REMOVED_COLUMNS=false
SILVER_FULL_REFRESH=false
BRONZE_LOG_RETENTION=interval 30 days
BRONZE_FILE_RETENTION=interval 7 days

# Performance (measured defaults, see docs/performance.md)
SPARK_DRIVER_MEMORY=2g
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=8
JDBC_FETCH_SIZE=10000
JDBC_BATCH_SIZE=10000
JDBC_WRITE_PARTITIONS=4
DELTA_ROWS_PER_FILE=1000000

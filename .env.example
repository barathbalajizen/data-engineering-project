# Local Data Lake Configuration
STORAGE_PROVIDER=local
LOCAL_DATA_LAKE_PATH=C:/ecommerce_delta_lake
LOCAL_STORAGE_FORMAT=delta

# Azure Storage Configuration (later, when you have Azure)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# Bronze/Silver/Gold Layer Names
BRONZE_CONTAINER=bronze
SILVER_CONTAINER=silver
GOLD_CONTAINER=gold

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres

# API Configuration
DUMMYJSON_BASE_URL=https://dummyjson.com
API_TIMEOUT=30
API_RETRIES=3
API_BACKOFF_FACTOR=1.5

# Data Paths (local development)
DATA_DIR=./data
ORDERS_CSV_PATH=./data/olist_orders.csv
REVIEWS_CSV_PATH=./data/olist_reviews.csv

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Prefect (for later phases)
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_KEY=your_api_key

# Environment
ENV=development  # development, staging, production

# Production configuration template. Copy to .env.prod (git-ignored), fill in the secrets, and start with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Better still: inject PG_PASSWORD / ALERT_WEBHOOK_URL from a secrets manager instead of a file.
APP_ENV=prod

PG_USER=pipeline
PG_PASSWORD=change-me-to-a-long-random-password
PG_DB=shop

PREFECT_PORT=4200
DASHBOARD_PORT=8501

SCHEDULE_TZ=UTC
DAILY_CRON=0 2 * * *
MAINTENANCE_CRON=0 3 * * 0

ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
LOG_FORMAT=json

WATERMARK_LOOKBACK_MINUTES=10
SCHEMA_DRIFT_ALLOW_REMOVED_COLUMNS=false
SILVER_FULL_REFRESH=false
BRONZE_LOG_RETENTION=interval 30 days
BRONZE_FILE_RETENTION=interval 7 days
SPARK_DRIVER_MEMORY=4g
SPARK_MASTER=local[4]
SPARK_SHUFFLE_PARTITIONS=8
JDBC_FETCH_SIZE=10000
JDBC_BATCH_SIZE=10000
JDBC_WRITE_PARTITIONS=4
DELTA_ROWS_PER_FILE=1000000
